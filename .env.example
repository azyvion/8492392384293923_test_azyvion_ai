# --- Groq (chat model) ---
GROQ_API_KEY=your_groq_api_key_here
# Optional: any model from https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

PORT=3000

# Optional: comma-separated list of origins allowed to call the API,
# e.g. https://yourname.github.io — leave unset to allow all origins.
ALLOWED_ORIGINS=

# --- Google sign-in ---
# Create an OAuth Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials
# Add your frontend origin(s) to "Authorized JavaScript origins", e.g.
# http://localhost:3000 and https://yourname.github.io
GOOGLE_CLIENT_ID=194566142436-07pven8a6uh0clmgcqphcoquhkppekjl.apps.googleusercontent.com

# --- Sessions ---
# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string

# Optional: where the SQLite database file is stored.
# Defaults to ./data/azyvion.db
DB_PATH=

